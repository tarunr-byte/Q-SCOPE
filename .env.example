# =====================================================================
# Q-SCOPE ENVIRONMENT CONFIGURATION
# =====================================================================

# Server Port (Railway automatically sets PORT)
PORT=8000
APP_ENV=production

# Database URL
# In Railway: add a PostgreSQL service and link it; DATABASE_URL is injected automatically!
# For local dev: defaults to sqlite:///./qscope.db
DATABASE_URL=sqlite:///./qscope.db

# Live AI Inference Keys (Optional: if provided, live Groq / NVIDIA LLM queries are enabled)
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional Security Bearer Token (Leave empty to allow public web access)
API_ACCESS_TOKEN=
